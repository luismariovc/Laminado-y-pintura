<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp"
    app:cardBackgroundColor="@color/white">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Status Strip (Left) -->
        <View
            android:id="@+id/statusStrip"
            android:layout_width="6dp"
            android:layout_height="0dp"
            android:background="@color/premium_red"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <!-- Folio & Date -->
        <TextView
            android:id="@+id/tvCardFolio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FOLIO #003"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/premium_red"
            android:layout_marginStart="12dp"
            android:layout_marginTop="12dp"
            app:layout_constraintStart_toEndOf="@id/statusStrip"
            app:layout_constraintTop_toTopOf="parent"/>

        <TextView
            android:id="@+id/tvCardDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="02/02/2026"
            android:textSize="12sp"
            android:textColor="#9CA3AF"
            android:layout_marginEnd="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBaseline_toBaselineOf="@id/tvCardFolio"/>

        <!-- Divider -->
        <View
            android:id="@+id/cardDivider"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:background="#F3F4F6"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="12dp"
            app:layout_constraintStart_toEndOf="@id/statusStrip"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvCardFolio"/>

        <!-- Customer Name -->
        <TextView
            android:id="@+id/tvCardCliente"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Juan Pérez"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#1F2937"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:layout_marginEnd="8dp"
            app:layout_constraintStart_toStartOf="@id/tvCardFolio"
            app:layout_constraintEnd_toStartOf="@id/tvCardTotal"
            app:layout_constraintTop_toBottomOf="@id/cardDivider"/>

        <!-- Vehicle Info -->
        <TextView
            android:id="@+id/tvCardVehiculo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Volkswagen Jetta 2019"
            android:textSize="14sp"
            android:textColor="#6B7280"
            android:ellipsize="end"
            android:maxLines="1"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="12dp"
            app:layout_constraintStart_toStartOf="@id/tvCardCliente"
            app:layout_constraintEnd_toStartOf="@id/tvCardTotal"
            app:layout_constraintTop_toBottomOf="@id/tvCardCliente"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <!-- Total Amount -->
        <TextView
            android:id="@+id/tvCardTotal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="$12,500.00"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#1F2937"
            android:layout_marginEnd="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/tvCardCliente"
            app:layout_constraintBottom_toBottomOf="@id/tvCardVehiculo"/>

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_car_profile"
            app:tint="#D1D5DB"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginBottom="4dp"
            android:layout_marginEnd="4dp"
            android:alpha="0.2"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>
